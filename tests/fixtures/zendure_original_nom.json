  "nom": [
    {
      "conditions": [
        {
          "condition": "trigger",
          "id": [
            "aansturing_trigger"
          ]
        },
        {
          "alias": "sensor.p1_aansturing_vermogen groter dan input_number.zendure_2400_ac_start_ontladen_bij",
          "condition": "template",
          "value_template": "{{ states('sensor.p1_aansturing_vermogen') | float(0)\n   > states('input_number.zendure_2400_ac_ontladen_starten_bij') | float(0) }}\n"
        },
        {
          "condition": "state",
          "entity_id": "sensor.zendure_2400_ac_soc_limiet_status",
          "state": [
            "Normale werking",
            "Laadlimiet bereikt",
            "unknown"
          ]
        },
        {
          "alias": "Tot de minimaal ingestelde SOC",
          "condition": "template",
          "value_template": "{{ states('sensor.zendure_2400_ac_laadpercentage') | float >\n states('sensor.zendure_2400_ac_minimale_laadpercentage') | float }}\n"
        },
        {
          "condition": "numeric_state",
          "entity_id": "sensor.zendure_2400_ac_vermogen_aansturing",
          "above": -30,
          "below": 30
        },
        {
          "alias": "Minstens 2 automatiseringen na opladen pas activeren",
          "condition": "or",
          "conditions": [
            {
              "condition": "state",
              "entity_id": "sensor.zendure_2400_ac_modus",
              "state": "Opladen",
              "for": {
                "hours": 0,
                "minutes": 0,
                "seconds": 9
              }
            },
            {
              "condition": "state",
              "entity_id": "sensor.zendure_2400_ac_modus",
              "state": "Ontladen"
            },
            {
              "condition": "state",
              "entity_id": "sensor.zendure_2400_ac_modus",
              "state": "Standby"
            }
          ]
        },
        {
          "condition": "or",
          "conditions": [
            {
              "condition": "or",
              "conditions": [
                {
                  "condition": "state",
                  "entity_id": "input_select.zendure_2400_ac_modus_selecteren",
                  "state": "Nul op de meter"
                },
                {
                  "condition": "state",
                  "entity_id": "input_select.zendure_2400_ac_modus_selecteren",
                  "state": "Alleen slim ontladen"
                },
                {
                  "condition": "state",
                  "entity_id": "input_select.zendure_2400_ac_modus_selecteren",
                  "state": [
                    "Dynamisch NOM"
                  ]
                },
                {
                  "condition": "state",
                  "entity_id": "input_select.zendure_2400_ac_modus_selecteren",
                  "state": [
                    "Dynamisch Handelen + NOM"
                  ]
                }
              ]
            },
            {
              "condition": "and",
              "conditions": [
                {
                  "condition": "state",
                  "entity_id": "sensor.dynamisch_duurste_periode",
                  "state": [
                    "Ja"
                  ]
                },
                {
                  "condition": "state",
                  "entity_id": "input_select.zendure_2400_ac_modus_selecteren",
                  "state": [
                    "Dynamisch NOM (Duur)"
                  ]
                },
                {
                  "alias": "sensor.dynamisch_spread_indicatie moet hoger of gelijk zijn aan input_number.dynamisch_minimale_spread",
                  "condition": "template",
                  "value_template": "{{ states('sensor.dynamisch_spread_indicatie') | float >= states('input_number.dynamisch_minimale_spread') | float }}"
                }
              ]
            }
          ]
        },
        {
          "condition": "and",
          "conditions": [
            {
              "condition": "state",
              "entity_id": "input_boolean.dynamisch_laden_loopt",
              "state": [
                "off"
              ]
            },
            {
              "condition": "state",
              "entity_id": "input_boolean.dynamisch_ontladen_loopt",
              "state": [
                "off"
              ]
            }
          ]
        },
        {
          "condition": "not",
          "conditions": [
            {
              "condition": "state",
              "entity_id": "sensor.p1_aansturing_vermogen",
              "state": [
                "unknown",
                "unavailable"
              ]
            }
          ]
        }
      ],
      "sequence": [
        {
          "data": {
            "sn": "{{ states('sensor.zendure_2400_ac_serienummer') }}",
            "outputLimit": "{% set factor = 0.75 %}  {% set cap = states('input_number.zendure_2400_ac_max_ontlaadvermogen') | float(0) %} {% set correctie = -1 * (states('input_number.zendure_2400_ac_ontlaadmarge') | float(0)) %} {% set p1 = states('sensor.p1_aansturing_vermogen') | float(0) %}  {% set zendure = states('sensor.zendure_2400_ac_vermogen_aansturing') | float(0) %}\n{% set totaal = (p1 - zendure - correctie) * factor %} {% set beperkt = [ [totaal, 0] | max, cap ] | min %}\n{{ beperkt | int }}"
          },
          "action": "rest_command.zendure_x_ontladen"
        },
        {
          "action": "logbook.log",
          "data": {
            "message": "🔋Ontladen starten — Vermogen ingesteld op {% set factor = 0.75 %} \n  {% set cap = states('input_number.zendure_2400_ac_max_ontlaadvermogen') | float(0) %}\n  {% set correctie = -1 * (states('input_number.zendure_2400_ac_ontlaadmarge') | float(0)) %}\n  {% set p1 = states('sensor.p1_aansturing_vermogen') | float(0) %} \n  {% set zendure = states('sensor.zendure_2400_ac_vermogen_aansturing') | float(0) %}\n\n  {% set totaal = (p1 - zendure - correctie) * factor %} {% set beperkt = [\n  [totaal, 0] | max, cap ] | min %} {{ beperkt | int }} watt —\n",
            "entity_id": "input_select.zendure_2400_ac_modus_selecteren",
            "name": " "
          }
        }
      ],
      "alias": "Start met ontladen bij +xxx watt (75% van de vraag)"
